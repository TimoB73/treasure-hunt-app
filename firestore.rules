rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jagden schreibt nur die Cloud Function (Admin-SDK umgeht diese Regeln).
    // Lesen per Link ohne Konto (die ID ist nicht zu erraten); auflisten nur die eigenen.
    match /hunts/{huntId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Fortschritt beim Erzeugen – nur für die Person, die die Jagd erzeugt.
    // Vor dem ersten Schritt existiert das Dokument noch nicht (resource == null).
    match /jobs/{jobId} {
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow list, write: if false;
    }

    // Gästeliste, Admins und Kontingentzähler – nur für Cloud Functions
    match /allowlist/{email} {
      allow read, write: if false;
    }
    match /admins/{uid} {
      allow read, write: if false;
    }
    match /usage/{docId} {
      allow read, write: if false;
    }
  }
}
