rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jagden schreibt nur die Cloud Function (Admin-SDK umgeht diese Regeln).
    // Lesen: jede angemeldete Person per Link; auflisten nur die eigenen.
    match /hunts/{huntId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Kontingentzähler – nur für die Cloud Function
    match /usage/{docId} {
      allow read, write: if false;
    }
  }
}
